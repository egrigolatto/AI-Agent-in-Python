# ─────────────────────────────────────────────────────────────────────────────
# .env.example — plantilla de configuración del agente
#
# Copiá este archivo a `.env` (excluido de Git) y completá lo que necesites:
#     cp .env.example .env
#
# Todas las variables son OPCIONALES: los valores mostrados son los defaults
# del código (src/ai_agent/config.py). Prioridad: argumentos de CLI > este
# archivo/entorno > preset del proveedor > default.
#
# Nunca subas tu `.env` real a Git ni compartas claves.
# ─────────────────────────────────────────────────────────────────────────────

# ═══════════ PROVEEDOR DE LLM ═══════════
# openrouter (default, nube) | ollama (local, sin clave) | openai | custom
AGENT_PROVIDER=openrouter

# Modelo concreto. Si se omite usa el default del preset:
#   openrouter → openrouter/free | ollama → qwen3:8b | openai → gpt-4o-mini
# AGENT_MODEL=

# Base URL de la API. Solo hace falta con AGENT_PROVIDER=custom
# (cualquier servidor compatible con la API de OpenAI):
#   Ollama:        http://localhost:11434/v1
#   Groq:          https://api.groq.com/openai/v1
#   LM Studio:     http://localhost:1234/v1
# AGENT_BASE_URL=

# ═══════════ CLAVES DE API ═══════════
# Genérica (vale para cualquier proveedor; gana sobre las legacy de abajo):
# AGENT_API_KEY=

# Legacy: la clave del preset correspondiente se busca también aquí, así un
# .env de versiones anteriores del proyecto sigue funcionando sin cambios:
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# (Ollama es local: no necesita ninguna clave real. Si el SDK exige un
#  valor, el proyecto usa el literal "ollama". No hace falta definir nada.)

# ═══════════ COMPORTAMIENTO DEL AGENTE ═══════════
# Directorio de trabajo (sandbox): el agente no lee, escribe ni ejecuta
# fuera de esta ruta. Default: ./calculator (el proyecto demo).
AGENT_WORKDIR=./calculator

# Límite de vueltas del bucle herramienta→modelo por turno (RNF-02).
AGENT_MAX_ITERATIONS=20

# Máximo de caracteres devueltos por get_file_content (RNF-03).
AGENT_MAX_FILE_CHARS=10000

# Aleatoriedad de la generación; 0 = lo más determinista.
AGENT_TEMPERATURE=0.0

# Timeout por request al proveedor, en segundos.
AGENT_REQUEST_TIMEOUT=120

# true para mostrar por defecto tokens/argumentos/resultados (equivale a --verbose).
AGENT_VERBOSE=false
